# PMM 3 client on the host. State: pmm3.agent
pmm3_agent:
  pmm_host: pmm.example.com
  #pmm_port: 443                              # optional
  #pmm_user: admin                            # optional
  pmm_password: XXXXXXXXXXXXXXXX
  #version: 3.10.0*                           # optional, pmm-client package version
  #node_name: db1.example.com                 # optional, default - hostname; alert dashboards match it (node_name),
                                              # the MySQL service is named <node_name>-mysql
  #node_address: 10.0.0.1                     # optional, with node_name, default - first fqdn_ip4
  services:
    mysql:
      enabled: True
      #user: pmm                              # optional
      password: YYYYYYYYYYYYYYYYY
      #socket: /var/run/mysqld/mysqld.sock    # optional, default - @@socket
      #query_source: perfschema               # optional
    haproxy:
      enabled: False
      port: 8404
    mongodb:                                  # service <node_name>-mongodb; create the MongoDB user first (README)
      enabled: False
      #user: pmm                              # optional
      password: XXXXXXXXX
      #host: 127.0.0.1                        # optional
      #port: 27017                            # optional
      #query_source: none                     # optional: none | mongolog (MongoDB 5.0+) | profiler
      #cluster: clustername                   # optional, PMM cluster label (replica set dashboards)
      #replication_set: rs0                   # optional, replica set name
      #environment: prod                      # optional
