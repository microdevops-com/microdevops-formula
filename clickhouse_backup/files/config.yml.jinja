{#- Managed by Salt (clickhouse_backup formula). Local changes will be overwritten. #}
general:
  remote_storage: none
  # We own retention ourselves via run.sh + rsnapshot_backup rotation on the backup server,
  # so clickhouse-backup itself is not allowed to prune local backups.
  backups_to_keep_local: 0

clickhouse:
  host: {{ ch_host }}
  port: {{ ch_port }}
  username: "USERNAME_HERE"
  password: "PASSWORD_HERE"
  skip_tables:
    - system.*
    - INFORMATION_SCHEMA.*
    - information_schema.*
