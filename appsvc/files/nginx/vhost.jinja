upstream {{ vhost["name"] }} {
    server {{ vhost["upstream"] }};
    keepalive 10;
}
{%- if vhost["tls"] %}

server {
    listen 80;
    server_name {{ vhost["domain"] }};
    location / {
        return 301 https://$host$request_uri;
    }
}
{%- endif %}

server {
{%- if vhost["tls"] %}
    listen 443 ssl;
    server_name {{ vhost["domain"] }};

    ssl_certificate {{ vhost["ssl_cert"] }};
    ssl_certificate_key {{ vhost["ssl_key"] }};
{%- else %}
    listen 80;
    server_name {{ vhost["domain"] }};
{%- endif %}
{%- if vhost["htpasswd_file"] %}

    auth_basic "Administrator's Area";
    auth_basic_user_file {{ vhost["htpasswd_file"] }};
{%- endif %}

    root /dev/null;
    charset UTF-8;
    autoindex off;

    access_log {{ vhost["access_log"] }};
    error_log {{ vhost["error_log"] }};

    client_max_body_size 25m;

    location / {
        proxy_pass http://{{ vhost["name"] }};
        proxy_set_header       Host             $host;
        proxy_set_header       X-Real-IP        $remote_addr;
        proxy_set_header       X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_send_timeout     240;
        proxy_read_timeout     240;
        proxy_connect_timeout  240;
    }
}
