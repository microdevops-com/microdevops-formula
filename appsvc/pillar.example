# appsvc - run N instances of a service or application
# (VictoriaMetrics, VictoriaLogs, Grafana, exporters, Python daemons, apps, ...)
# under systemd, each independently configured.
#
# Resolution, see appsvc/init.sls / readme.md for the full story. Pass 1 merges
# and formats EVERY instance; pass 2 gathers cross-instance scrape jobs and
# dispatches the selected subset:
#   1. each instance is merged:
#      settings = merge(appsvc/defaults.yaml, presets/<preset>.yaml, <instance>)
#      - everything here merges deep-dict-wise / replaces-wholesale, EXCEPT
#        structured svc.args, which is merged by flag name (merge_args in
#        lib/core.py), so an instance can override e.g. just httpListenAddr from a
#        preset's args without restating storageDataPath/retentionPeriod/... too
#        (string entries inside args lists are literal tokens; top-level raw
#        string args replace wholesale)
#   2. each instance resolves version/source (only if selected - see filter),
#      then every {placeholder} string anywhere in `settings` is expanded in two
#      passes - first against grain-derived identity + the instance's own
#      static keys (name/type/version/tag/tag_vstrip/osarch/grain_id/...), then
#      again once install_dir/exec/args/user_name/user_group are themselves
#      known. scrape stanzas are expanded by this same pass, in producer scope.
#   3. if `scrape_collect` is set, the (now-expanded) jobs from matching
#      instances' `scrape` stanzas are appended to the configured config path.
#   4. building blocks run in order: user/ssh, install_dir, dirs, pyenv, nvm, tools,
#      env_sh, sources, config,
#      svc (fetch), venv, php_fpm, commands(pre), systemd, commands(post), cron, nginx,
#      logrotate.
#      dirs precede sources (a checkout's parent exists), sources precede
#      config (a config entry can write into a checkout). install_dir runs
#      ahead of config on purpose (a config entry with makedirs would otherwise
#      create the install dir root-owned before the service user's ownership
#      lands), and even without a svc block at all - e.g. a venv-only instance.
#      venv runs after fetch - its requirements_files may point at a
#      requirements.txt that arrives inside the fetched archive.
#
# Available placeholders (anywhere in an instance's settings):
#   {name}          instance key (the dict key under appsvc:instances)
#   {type}          preset name, or {name} if no preset is used
#   {version}       svc.version, resolved if it was "latest"
#   {tag}           release tag (usually == version, e.g. "v1.9.0")
#   {tag_vstrip}    {tag} with a leading "v" stripped (e.g. "1.9.0")
#   {osarch}        GOARCH-style arch (amd64/arm64/...)
#   {kernel_lower}  lowercased kernel grain (e.g. "linux")
#   {cpuarch}       cpuarch grain
#   {grain_id}      minion id (grains:id), e.g. "host.dc1.example"
#   {install_dir}   resolved install_dir (2nd pass only)
#   {exec}          resolved svc.exec path (2nd pass only)
#   {args}          svc.args rendered with svc.args_prefix plus literal string tokens (2nd pass only)
#   {user_name}     resolved user.name, default "root" (2nd pass only)
#   {user_group}    resolved user.group, default {user_name} (2nd pass only)
#   {svc_target}    resolved fetch destination when svc.source is set, else ""
#                   (2nd pass only) - what makes ExecStart: "... {svc_target}"
#                   work for a kind: file instance without repeating the path
#   {home}          user.home if set, else /root for root, else /home/<user.name>
#                   (2nd pass only)
#   {venv_dir}      resolved venv.dir, e.g. "{install_dir}/venv" (2nd pass
#                   only) - NOT {venv}, which would render the whole venv
#                   config dict's repr
#   {nvm_dir}       nvm checkout: {home}/.nvm for a non-root user.name, /usr/local/nvm
#                   for root; an explicit nvm.dir wins (2nd pass only)
#   {pyenv_root}    {home}/.pyenv, or /usr/local/pyenv for root; pyenv.root wins
#   {tools_dir}     {home}/.local/bin, or /usr/local/bin for root
#   {env_sh}        {home}/.appsvc/<name>.sh, or /etc/profile.d/appsvc-<name>.sh
#                   for root; shell_env.path wins. Always defined, even without
#                   nvm/pyenv/tools: e.g. cmd ". {env_sh} && composer install"
#   {<global>}      any key under appsvc:globals (see below)


appsvc:

  # Optional GitHub API token for `version: latest` resolution (github resolver).
  # Lifts the unauthenticated 60 req/hr/IP limit to 5000/hr - the fix for minions
  # rendering behind a shared NAT egress IP, where the on-disk resolve cache can't
  # be shared (see WHITEPAPER.md §10). Sent only to api.github.com, never to other
  # resolvers' endpoints. A secret - keep it in secured/encrypted pillar.
  # github_token: ghp_xxxxxxxxxxxxxxxxxxxx

  # Scope a single `state.apply` to a subset of instances. Usually typed on the
  # CLI, not stored here:
  #   state.apply appsvc pillar='{appsvc: {filter: "name: vm* *gra*; preset: exporter*"}}'
  # Semicolon-separated "<key>: <glob>..." clauses; keys are name or preset
  # (anything else fails loud). Union semantics: an instance applies if its name
  # matches any name glob OR its preset matches any preset glob. All other
  # instances are still merged (so a selected vmagent gathers every exporter's
  # scrape job) but not dispatched. Omit to apply all instances.
  # filter: "name: vm*"

  # Operator-defined placeholders shared by every instance, usable as {key} in
  # any settings string just like {name}/{type}/... Values are literal (no
  # recursive expansion). A key that collides with a reserved placeholder
  # (name/type/grain_id/...) fails the render loudly rather than silently
  # shadowing it.
  # globals:
  #   dc: eu-west-1
  #   remote_write: "https://vm.eu-west-1.example.com/api/v1/write"

  # Per-preset overrides, deep-merged over the bundled salt://appsvc/presets/
  # files - only specify what differs. Omit a preset entirely to use it as-is.
  presets:
    vlserver:
      svc:
        version: v1.9.0   # pin instead of tracking "latest"

  instances:

    # --- minimal: a single VictoriaLogs instance, defaults all the way ---
    vlserver:
      preset: vlserver
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: vlogs
        group: vlogs
      svc:
        version: latest

    # --- a second, independent instance of the same preset on the same host ---
    vlserver_b:
      preset: vlserver
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: vlogs-secondary
        group: vlogs-secondary
      svc:
        version: v1.8.0
        # args is merged with the preset's by flag name (merge_args in lib/core.py)
        # rather than replaced wholesale, so overriding just the listen address
        # here still keeps the preset's storageDataPath/retentionPeriod intact.
        args:
          - httpListenAddr: "127.0.0.1:9429"
      nginx:
        manage: true
        # One entry per server group. `name` keeps the sites-available file and
        # ACME cert path stable ("vlserver_b" = this instance's old default).
        # auth_basic is per vhost: one htpasswd file keyed on the vhost name.
        vhosts:
          # ACME DNS: write only acme_account; the block derives ssl_cert/
          # ssl_key from /opt/acme/cert/<name>_<first-name>_{fullchain.cer,key.key}.
          # The account must exist in pillar["acme"] and be applied by the acme
          # state; appsvc does not manage acme accounts.
          public:
            name: vlserver_b
            upstream: "127.0.0.1:9429"
            names: [logs.example.com]
            acme_account: example_com
            auth_basic:
              - username: admin
                password: change-me
          # Operator-supplied certs:
          internal:
            upstream: "127.0.0.1:9429"
            names: [logs-internal.example.com]
            ssl_cert: /etc/ssl/certs/internal.fullchain.pem
            ssl_key: /etc/ssl/private/internal.key
          # No TLS -> HTTP only:
          plain:
            upstream: "127.0.0.1:9429"
            names: [logs-plain.example.com]

    # --- VictoriaMetrics from a direct URL instead of "latest"/a tag ---
    vmserver:
      preset: vmserver
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: vmserver
        group: vmserver
      svc:
        source: "https://github.com/VictoriaMetrics/VictoriaMetrics/releases/download/v1.101.0/victoria-metrics-linux-amd64-v1.101.0.tar.gz"
        source_hash: "https://github.com/VictoriaMetrics/VictoriaMetrics/releases/download/v1.101.0/victoria-metrics-linux-amd64-v1.101.0_checksums.txt"
        version: v1.101.0
      config:
        main:
          name: "{install_dir}/scrape.yml"
          # Optional format: yaml (default), ini, json.
          contents:
            global:
              scrape_interval: 30s

    # --- vmagent from the vmutils archive, remote-writing to VictoriaMetrics ---
    vmagent:
      preset: vmagent
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: vmagent
        group: vmagent
      svc:
        # args is merged by flag name, so overriding only remoteWrite.url keeps
        # the preset's tmpDataPath/httpListenAddr/promscrape.config flags.
        args:
          - remoteWrite.url: "http://127.0.0.1:8428/api/v1/write"
      # The preset's scrape_collect appends matching producers' literal scrape
      # jobs into config.promscrape.yml.contents.scrape_configs. It also ships
      # its own vmagent self-scrape job.

    # --- Prometheus Node Exporter from the official GitHub release tarball ---
    exporter_node:
      preset: exporter_node
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: exporter_node
        group: exporter_node
      svc:
        args:
          # exporter_node preset sets args_prefix: "--".
          - web.listen-address: "127.0.0.1:9100"
      # Override the preset's vmagent: ["*"] default to narrow this producer to
      # one local vmagent instance.
      #
      # scrape.config is expanded like any other config, in the PRODUCER's own
      # scope (a job is declared here yet rendered into the consumer's config),
      # so {name}/{type}/{grain_id}/{install_dir}/... all work. One caveat: under
      # appsvc:filter, {version}/{tag} of a producer NOT in the selected subset
      # stay unresolved (resolution is gated to selected instances) until a full
      # apply. For values outside the placeholder set, use Salt jinja IN PILLAR
      # (rendered before appsvc; pillar only, not a bundled presets/*.yaml, which
      # is yaml.safe_load'd) - e.g. {{ grains["fqdn"] }}.
      scrape:
        vmagent: ["metrics"]
        config:
          - job_name: node
            static_configs:
              - targets:
                  - "127.0.0.1:9100"
                labels:
                  instance: "{grain_id}"

    # --- Grafana from the official standalone tarball ---
    grafana:
      preset: grafana
      install_dir: "/opt/services/{type}/{name}"
      # Set Grafana's admin password (secured/encrypted pillar - it reaches the
      # grafana CLI via stdin, not argv). Omit to leave Grafana's default.
      admin_password: "change-me"
      user:
        manage: true
        name: grafana
        group: grafana
      nginx:
        manage: true
        vhosts:
          grafana:
            name: grafana
            upstream: "127.0.0.1:3000"
            names: [grafana.example.com]
            acme_account: example_com

    # --- no preset at all: every building block driven straight from pillar ---
    custom_exporter:
      type: my_exporter
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: my_exporter
        group: my_exporter
      svc:
        source: "https://example.com/downloads/my_exporter-{osarch}.tar.gz"
        version: "1.2.3"
        move:
          src: "{file}"
          dst: "{install_dir}/my_exporter"
        exec: "{install_dir}/my_exporter"
        # Opt-in idempotency: with no version_check the archive re-extracts (and
        # the service restarts) every run. {binary} = exec's first token; {tag}/
        # {version}/{install_dir} are already resolved. For a binary with no
        # version flag, check a stamp file or any command (exit 0 = up to date),
        # or omit this entirely to accept re-extract-every-run.
        version_check: "[[ $({binary} -version 2>&1) =~ {version} ]]"
        args:
          - web.listen-address: "127.0.0.1:9200"
        # Dirs the service must write into that the archive ships root-owned
        # (sqlite db, plugins, logs, ...). Made service-user-owned after
        # extraction, recursively; program files stay root-owned. The grafana
        # preset uses this for "{install_dir}/data"; most stateless exporters
        # need nothing here.
        # data_dirs:
        #   - "{install_dir}/data"
      systemd:
        units:
          main:
            # Without `name` the unit would be appsvc_custom_exporter_main
            # (systemd.defaults.name: "appsvc_{name}_{unit}").
            name: "appsvc_{name}"
            Service:
              ExecStart: "{exec} {args}"
              User: "{user_name}"
              Group: "{user_group}"

    # --- a bare Python script, fetched as a plain file (kind: file) ---
    # No tarball, no tar-extract: svc.source's basename (.py) isn't a
    # recognized archive suffix, so fetch_kind infers "file" - a single
    # File.managed that compares content hashes itself, no cache hop. Useful
    # for a script served straight from salt:// or a raw URL. This instance
    # runs under the system python3 for brevity; see the `redis_check`
    # instance below for a managed venv (top-level `venv:` key, TODO.md item
    # 17) so ExecStart doesn't have to rely on the system python3 and its
    # already-installed packages.
    plain_script:
      type: plain_script
      install_dir: "/opt/services/{type}/{name}"
      user:
        manage: true
        name: plain_script
        group: plain_script
      svc:
        source: "https://example.com/example_script.py"
        # kind: file is inferred here; set it explicitly if a source's
        # basename could be mistaken for something else.
        # target defaults to "{install_dir}/example_script.py" (the
        # source's basename) - pin a friendlier on-disk name instead:
        target: "{install_dir}/example_script.py"
      systemd:
        # Several units per instance, keyed by {unit}. Each is merged over
        # systemd.defaults (defaults.yaml) and restarts whenever the script,
        # config or venv changes.
        units:
          main:                   # -> appsvc_plain_script_main.service
            Service:
              Type: simple
              # {svc_target} == svc.target above, resolved - avoids repeating
              # the path here.
              ExecStart: "/usr/bin/python3 {svc_target}"
              User: "{user_name}"
              Group: "{user_group}"
              WorkingDirectory: "{install_dir}"
              Restart: on-failure
              RestartSec: 10
          report:
            name: plain-script-report     # explicit unit name (".service" optional)
            Unit:
              Description: "appsvc: {name} report ({unit_name})"
            Service:
              ExecStart: "/usr/bin/python3 {svc_target} --report"
              User: "{user_name}"
              Group: "{user_group}"
          # A unit removed from pillar is left as it is on the host. To remove
          # it, keep the key and mark it - it is stopped, disabled and deleted:
          # old_worker: {delete: true}

    # --- redis_check: a Python daemon under a appsvc-managed venv ---
    # This is the whole point of the venv block (TODO.md item 17): the preset
    # (presets/redis_check.yaml) supplies kind: file fetch + venv.requirements
    # + the systemd unit; the instance only sets svc.source and whatever
    # redis_check.yaml.example keys it needs to override.
    redis_check:
      preset: redis_check
      install_dir: "/opt/services/{type}/{name}"
      config:
        redis_check.yaml:
          contents:
            alert:
              client: acme

    # --- crm: a git-deployed app (no daemon) owned by one unix user ---
    # No `svc`, no systemd units (an instance without systemd.units has
    # none; systemd.manage: false also turns off a preset's units). Clones two
    # repos once, writes an env file into a checkout, installs dependencies
    # only when a checkout changes, and keeps a session-cleanup cron entry.
    # {home} is user.home here: /var/www/.releaser.
    # (composer/npm on PATH arrive with a later step's tools/nvm blocks.)
    crm:
      install_dir: "{home}"
      user:
        manage: true
        name: releaser
        group: releaser
        home: /var/www/.releaser
        shell: /bin/bash
      ssh:
        keys:
          id_ed25519: "<private key>"
        known_hosts:
          hosts:
            - gitlab.example.com:22
      dirs:
        sessions: /var/lib/php/crm-sessions     # string shorthand
        logs:
          name: "{home}/log"
          mode: "750"
      sources:
        backend:
          git: git@gitlab.example.com:group/backend.git
          target: "{home}/backend"
          once: true                # git.cloned: clone if missing, never update
        frontend:
          git: git@gitlab.example.com:group/frontend.git
          target: "{home}/frontend"
          once: true
      config:
        backend_env:
          name: "{home}/backend/.env.local"
          source: salt://crm/env.local.jinja
      commands:
        backend_deps:
          cmd: "composer install --no-dev --optimize-autoloader"
          cwd: "{home}/backend"
          runas: "{user_name}"
          phase: pre
          onchanges: [sources:backend]
        frontend_deps:
          cmd: "npm ci && npm run build"
          cwd: "{home}/frontend"
          runas: "{user_name}"
          phase: pre
          onchanges: [sources:frontend]
      cron:
        session_clean:
          schedule: "0 * * * *"
          cmd: "find /var/lib/php/crm-sessions -mtime +10 -delete"
          user: root

    # --- an app with php-fpm pools and nginx vhosts (Symfony back + React front) ---
    # appsvc never installs PHP, nginx or node: those are other states' jobs.
    # dirs must stay OUTSIDE the sources' targets (render fails otherwise); a
    # config entry inside a source target requires that source automatically.
    mt-helium:
      install_dir: /var/www/helium/crm
      user: {manage: true, name: helium, group: helium, shell: /bin/bash}
      dirs:
        nginx_log: "{install_dir}/log/nginx/mt-back"
        php_log: "{install_dir}/log/php/mt-back"
      sources:
        mt-front: {git: "git@gitlab.example.com:group/front.git", target: "{install_dir}/mt-front", once: true}
        mt-back: {git: "git@gitlab.example.com:group/back.git", target: "{install_dir}/mt-back", once: true}
      config:
        env_local:
          name: "{install_dir}/mt-back/.env.local"
          mode: "640"
          contents: "APP_NAME=tat\n"
      # Runtimes (see presets/generic.yaml): versions are lists of QUOTED strings,
      # the first is the default. Per-user here (user.name is not root); a root
      # instance gets /usr/local/{nvm,pyenv} and /etc/profile.d instead.
      # nvm: {versions: ["20"]}
      # pyenv: {versions: ["3.8.13"]}
      # tools:
      #   composer:
      #     source: https://getcomposer.org/download/2.6.6/composer.phar
      #     source_hash: https://getcomposer.org/download/2.6.6/composer.phar.sha256sum
      php_fpm:
        pools:
          mt-back:
            version: "8.3"            # a quoted string
            error_log: "{install_dir}/log/php/mt-back/mt-back.error.log"
            config: |
              pm = dynamic
              pm.max_children = 20
      nginx:
        manage: true
        vhosts:
          mt-back:
            names: [app.example.com]
            acme_account: example_com
            # Custom jinja; sees vhost_name, domain, names, ssl_cert, ssl_key,
            # access_log, error_log, htpasswd_file, php_fpm_sockets
            # ({pool_key: socket}) plus `vars`.
            template: salt://my-formula/nginx/mt-back.conf
            access_log: "{install_dir}/log/nginx/mt-back/mt-back.access.log"
            error_log: "{install_dir}/log/nginx/mt-back/mt-back.error.log"
            vars: {php_version: "8.3"}
      systemd: {manage: false}
